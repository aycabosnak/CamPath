{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": ".next/validate-content",
    "rootDir": ".",
    "incremental": false,
    "isolatedModules": false,
    "plugins": [],
    "types": ["node"]
  },
  "include": ["scripts/validate-content.ts"],
  "exclude": ["node_modules", ".next"]
}
